rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Customers register with email and password. Anonymous sessions
    // cannot create orders or profiles.
    //
    // Collection: users
    // Document ID: auth uid
    // Fields:
    //   - displayName: string (2-80)
    //   - email: string (must match the auth token, immutable)
    //   - favoriteIds: list of strings (0-100)
    //   - createdAt: timestamp (server time, immutable)
    //
    // Collection: products
    // Document ID: product id
    // Fields: name, subtitle, price, imageUrl, description, category, origin, badge, visible
    // Only the shop owner can create, edit, or delete. Customers can read visible products.
    //
    // Collection: orders
    // Document ID: auto-id
    // Fields:
    //   - uid: string (required, immutable) - registered auth uid
    //   - createdAt: timestamp (required, immutable) - server time
    //   - status: string (required, immutable) - only "recibido" from the client
    //   - paymentMethod: string (required, immutable) - YAPE or CARD
    //   - deliveryMode: string (required, immutable) - REFRIGERATED or PICKUP_SERRANO
    //   - timeSlot: string (required, immutable, 1-80)
    //   - giftWrapEnabled: bool (required, immutable)
    //   - giftCardMessage: string (required, immutable, 0-500)
    //   - currency: string (required, immutable) - PEN
    //   - items: list (required, immutable, 1-40)
    //   - subtotal: number (required, immutable, 0-100000)
    //   - giftWrapPrice: number (required, immutable, 0-1000)
    //   - total: number (required, immutable, 0-100000)
    //   - itemCount: int (required, immutable, 1-200)
    //
    // ===============================================================

    function isOwner() {
      return isRegistered()
        && request.auth.token.email == 'jos.antonio4772@gmail.com';
    }

    function isValidCategory(data) {
      return data.keys().hasOnly(['name', 'imageUrl', 'sort'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.imageUrl is string
        && data.imageUrl.size() <= 2000
        && data.sort is int
        && data.sort >= 0
        && data.sort <= 999;
    }

    function isStorefrontText(data, key) {
      return data[key] is string && data[key].size() <= 500;
    }

    function isValidStorefront(data) {
      return data.keys().hasOnly([
          'eyebrow', 'headline', 'cornerBadge', 'heroBadge', 'heroSeason', 'heroTitle',
          'heroBody', 'heroPriceCaption', 'heroPrice', 'heroButton', 'heroImageUrl',
          'categoriesHeading', 'productsHeading', 'productsNote',
          'deliveryTitle', 'deliveryDetail', 'giftTitle', 'giftDetail', 'profileTagline',
          'boxKicker', 'boxTitle', 'boxBody', 'boxStep1', 'boxStep2', 'boxStep3', 'boxButton',
          'quote', 'quoteName', 'quoteRole', 'sealTitle', 'sealBody', 'sealButton', 'footerLine',
          'trustCraft', 'trustCold', 'trustPay'
        ])
        && isStorefrontText(data, 'eyebrow')
        && isStorefrontText(data, 'headline')
        && isStorefrontText(data, 'cornerBadge')
        && isStorefrontText(data, 'heroBadge')
        && isStorefrontText(data, 'heroSeason')
        && isStorefrontText(data, 'heroTitle')
        && isStorefrontText(data, 'heroBody')
        && isStorefrontText(data, 'heroPriceCaption')
        && isStorefrontText(data, 'heroPrice')
        && isStorefrontText(data, 'heroButton')
        && data.heroImageUrl is string
        && data.heroImageUrl.size() <= 2000
        && isStorefrontText(data, 'categoriesHeading')
        && isStorefrontText(data, 'productsHeading')
        && isStorefrontText(data, 'productsNote')
        && isStorefrontText(data, 'deliveryTitle')
        && isStorefrontText(data, 'deliveryDetail')
        && isStorefrontText(data, 'giftTitle')
        && isStorefrontText(data, 'giftDetail')
        && isStorefrontText(data, 'profileTagline')
        && isStorefrontText(data, 'boxKicker')
        && isStorefrontText(data, 'boxTitle')
        && isStorefrontText(data, 'boxBody')
        && isStorefrontText(data, 'boxStep1')
        && isStorefrontText(data, 'boxStep2')
        && isStorefrontText(data, 'boxStep3')
        && isStorefrontText(data, 'boxButton')
        && isStorefrontText(data, 'quote')
        && isStorefrontText(data, 'quoteName')
        && isStorefrontText(data, 'quoteRole')
        && isStorefrontText(data, 'sealTitle')
        && isStorefrontText(data, 'sealBody')
        && isStorefrontText(data, 'sealButton')
        && isStorefrontText(data, 'footerLine')
        && isStorefrontText(data, 'trustCraft')
        && isStorefrontText(data, 'trustCold')
        && isStorefrontText(data, 'trustPay');
    }

    function isValidProduct(data) {
      return data.keys().hasOnly([
          'name', 'subtitle', 'price', 'imageUrl', 'description',
          'category', 'origin', 'badge', 'visible'
        ])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 120
        && data.subtitle is string
        && data.subtitle.size() <= 160
        && data.description is string
        && data.description.size() <= 2000
        && data.price is number
        && data.price >= 0
        && data.price <= 100000
        && data.imageUrl is string
        && data.imageUrl.size() <= 2000
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 80
        && data.origin is string
        && data.origin.size() <= 160
        && data.badge is string
        && data.badge.size() <= 40
        && data.visible is bool;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isRegistered() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['displayName', 'email', 'favoriteIds', 'createdAt'])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.email is string
        && data.email == request.auth.token.email
        && data.email.size() > 3
        && data.email.size() < 200
        && data.favoriteIds is list
        && data.favoriteIds.size() <= 100
        && data.createdAt is timestamp;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= minLen
        && request.resource.data[field].size() <= maxLen;
    }

    function isNonNegativeNumber(field, maxValue) {
      return request.resource.data[field] is number
        && request.resource.data[field] >= 0
        && request.resource.data[field] <= maxValue;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidOrder(data) {
      return hasOnlyAllowedFields([
          'uid', 'createdAt', 'status', 'paymentMethod', 'deliveryMode',
          'timeSlot', 'giftWrapEnabled', 'giftCardMessage', 'currency',
          'items', 'subtotal', 'giftWrapPrice', 'total', 'itemCount', 'culqiChargeId',
          'invoiceKind', 'invoiceSeries', 'invoiceNumber'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid.size() > 0
        && data.uid.size() < 128
        && data.createdAt == request.time
        && data.status == 'recibido'
        && data.paymentMethod in ['YAPE', 'CARD']
        && data.deliveryMode in ['REFRIGERATED', 'PICKUP_SERRANO']
        && validStringLength('timeSlot', 1, 80)
        && data.giftWrapEnabled is bool
        && validStringLength('giftCardMessage', 0, 500)
        && data.currency == 'PEN'
        && data.items is list
        && data.items.size() >= 1
        && data.items.size() <= 40
        && isNonNegativeNumber('subtotal', 100000)
        && isNonNegativeNumber('giftWrapPrice', 1000)
        && isNonNegativeNumber('total', 100000)
        && data.itemCount is int
        && data.itemCount >= 1
        && data.itemCount <= 200
        && data.culqiChargeId is string
        && data.culqiChargeId.size() <= 80
        && data.culqiChargeId.matches('^chr_(live|test)_[A-Za-z0-9]+$')
        && invoiceFieldsOk(data);
    }

    function invoiceFieldsOk(data) {
      return data.invoiceKind is string
        && data.invoiceSeries is string
        && data.invoiceNumber is string
        && data.invoiceSeries.size() <= 4
        && data.invoiceNumber.size() <= 8
        && (
          (data.invoiceKind == '' && data.invoiceSeries == '' && data.invoiceNumber == '')
          || (
            data.invoiceKind in ['boleta', 'factura']
            && data.invoiceSeries.matches('^[BF][A-Z0-9]{3}$')
            && data.invoiceNumber.matches('^[1-9][0-9]{0,7}$')
          )
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isOwner()
        && isValidCategory(request.resource.data)
        && categoryId.size() > 0
        && categoryId.size() <= 80;
      allow delete: if isOwner();
    }

    match /settings/{docId} {
      allow read: if docId == 'storefront';
      allow create, update: if isOwner()
        && docId == 'storefront'
        && isValidStorefront(request.resource.data);
      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if resource.data.visible == true || isOwner();
      allow list: if isOwner() || resource.data.visible == true;
      allow create, update: if isOwner()
        && isValidProduct(request.resource.data)
        && productId.size() > 0
        && productId.size() <= 80;
      allow delete: if isOwner();
    }

    match /users/{userId} {
      allow get: if isRegistered() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isRegistered()
        && request.auth.uid == userId
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isRegistered()
        && request.auth.uid == userId
        && isValidUser(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow get: if isRegistered() && isDocOwner();
      allow list: if isRegistered() && resource.data.uid == request.auth.uid;
      allow create: if isRegistered() && isValidOrder(request.resource.data);
      allow update: if isDocOwner()
        && isValidOrder(request.resource.data)
        && areImmutableFieldsUnchanged([
          'uid', 'createdAt', 'status', 'paymentMethod', 'deliveryMode',
          'timeSlot', 'giftWrapEnabled', 'giftCardMessage', 'currency',
          'items', 'subtotal', 'giftWrapPrice', 'total', 'itemCount', 'culqiChargeId'
        ])
        && (
          (
            request.resource.data.invoiceKind == resource.data.invoiceKind
            && request.resource.data.invoiceSeries == resource.data.invoiceSeries
            && request.resource.data.invoiceNumber == resource.data.invoiceNumber
          )
          || (
            resource.data.invoiceSeries == ''
            && request.resource.data.invoiceSeries != ''
          )
        );
      allow delete: if false;
    }
  }
}
